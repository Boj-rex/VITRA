# ==============================================================================
# VITRA — Environment Variables Template
# Copy this file to .env.local and provide real credentials for production
# or connected development. Never commit .env.local or actual secrets.
# ==============================================================================

# Public App URL (used for auth redirects and clickable links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE (Database, Authentication & Private Storage)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only service role key (required for account deletion & admin monitoring)
# NEVER expose this key with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Enable Google OAuth button on login/register pages once configured
# in Supabase Dashboard -> Authentication -> Providers -> Google
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ------------------------------------------------------------------------------
# AI WRITING ENGINE (Server-Side — Supports Google Gemini & OpenAI)
# Recommended free-tier start: Google Gemini (https://aistudio.google.com/apikey)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI fallback / alternative (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# INFRASTRUCTURE PROTECTION & RATE LIMITING
# ------------------------------------------------------------------------------
# Maximum daily AI requests per user (free tier protection)
VITRA_DAILY_AI_LIMIT=40
# Maximum uploaded CV size in bytes (default: 10 MB = 10485760)
VITRA_MAX_UPLOAD_BYTES=10485760

# ------------------------------------------------------------------------------
# DEVELOPMENT MODE FALLBACK (Local Non-Production Use Only)
# When Supabase or OpenAI credentials are omitted in local development, Vitra
# runs an honest local-development mode: persistence uses a local server JSON
# store (.vitra-dev-data/) and AI endpoints report unconfigured status clearly
# unless explicitly tested with deterministic local helpers.
# Set to "true" ONLY for local evaluation without external credentials.
# ------------------------------------------------------------------------------
VITRA_ALLOW_LOCAL_DEV_MODE=true

# ------------------------------------------------------------------------------
# SUPPORT INQUIRY EMAIL DELIVERY
# All customer support questions submitted via the popup form are routed here.
# ------------------------------------------------------------------------------
SUPPORT_RECIPIENT_EMAIL=Bolajim@gmail.com

# OPTION 1 (Direct Gmail Delivery): Using Google App Password
# Steps: 1. Turn ON 2-Step Verification in your Google Account
#        2. Go to https://myaccount.google.com/apppasswords
#        3. Create an app password named "Vitra Support" and paste the 16 characters below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=Bolajim@gmail.com
SMTP_PASS=

# OPTION 2 (Resend API): https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="Vitra Support <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# LOGIN SECURITY OTP LAYER (Two-Factor Authentication)
# Requires an email verification code on candidate login for tighter account security.
# Set to "false" only if you want to bypass OTP and use direct password-only login.
# ------------------------------------------------------------------------------
LOGIN_OTP_ENABLED=true

# ------------------------------------------------------------------------------
# AUTOMATED SYSTEM NOTIFICATIONS (NO-REPLY)
# Outbound address and Reply-To header for login OTP codes and payment receipts.
# ------------------------------------------------------------------------------
NO_REPLY_EMAIL=no-reply@vitra.app

# ------------------------------------------------------------------------------
# PAYSTACK PAYMENT GATEWAY
# Obtain your API keys from: https://dashboard.paystack.co/#/settings/developer
# ------------------------------------------------------------------------------
# Secret key for server-side initialization, verification, and webhooks (sk_test_... or sk_live_...)
PAYSTACK_SECRET_KEY=
# Public key for client-side checkouts (pk_test_... or pk_live_...)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=




